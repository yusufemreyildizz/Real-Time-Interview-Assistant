<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Live Interview Panel</title>
<style>
  :root { --bg:#0b0d12; --card:#141822; --line:#232a3a; --text:#e8ecf4; --muted:#7d879c; --accent:#6ee7b7; --blue:#7aa2ff; --red:#ef4444; }
  * { box-sizing:border-box; }
  body { margin:0; height:100vh; display:flex; flex-direction:column; background:var(--bg); color:var(--text);
         font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,sans-serif; }
  header { display:flex; gap:12px; align-items:center; padding:14px 20px; border-bottom:1px solid var(--line); }
  #dot { width:9px; height:9px; border-radius:50%; background:var(--red); }
  #dot.on { background:var(--accent); }
  #ctx { flex:1; background:var(--card); border:1px solid var(--line); color:var(--text); border-radius:10px; padding:9px 12px; font-size:14px; }
  main { flex:1; overflow-y:auto; padding:20px; display:flex; flex-direction:column; justify-content:flex-end; gap:10px; }
  .past { color:var(--muted); font-size:15px; line-height:1.4; margin-bottom:6px; }
  .past .t { color:#5f8f80; }
  .caption { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:22px 26px; margin-top:8px; }
  .en { font-size:28px; font-weight:600; line-height:1.3; }
  .en.interim { color:var(--muted); }
  .tr { font-size:24px; color:var(--accent); margin-top:12px; line-height:1.3; min-height:32px; }
  .replies { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; padding:0 20px 14px; }
  .chip { background:var(--card); border:1px solid var(--line); color:var(--text); border-radius:12px; padding:14px;
          text-align:left; font-size:15px; line-height:1.4; cursor:pointer; min-height:70px; transition:.15s; }
  .chip:hover { border-color:var(--blue); transform:translateY(-1px); }
  .chip.ghost { color:var(--muted); cursor:default; }
  .chip.copied { border-color:var(--accent); }
  form { display:flex; gap:10px; padding:0 20px 20px; }
  #inp, #src { background:var(--card); border:1px solid var(--line); color:var(--text); border-radius:12px; padding:14px 16px; font-size:16px; }
  #inp { flex:1; }
  #src { font-size:14px; padding:0 10px; }
  #inp:focus, #ctx:focus { outline:none; border-color:var(--blue); }
  button.send, button.mic { border:0; border-radius:12px; padding:0 20px; font-weight:600; cursor:pointer; }
  button.send { background:var(--blue); color:#0b0d12; }
  button.mic { background:var(--card); color:var(--text); border:1px solid var(--line); }
  button.mic.live { background:var(--red); border-color:var(--red); color:#fff; animation:pulse 1.4s infinite; }
  @keyframes pulse { 50% { opacity:.7; } }
  #err { color:#fca5a5; font-size:13px; padding:0 20px; min-height:18px; }
  @media (max-width:720px){ .replies{grid-template-columns:1fr;} .en{font-size:22px;} .tr{font-size:19px;} form{flex-wrap:wrap;} }
</style>
</head>
<body>
<header>
  <span id="dot"></span>
  <input id="ctx" placeholder="Bağlam (isteğe bağlı): örn. Mobil oyun UA mülakatı, ben aday olarak katılıyorum">
</header>
<main id="main">
  <div id="past"></div>
  <div class="caption">
    <div class="en" id="en">Dinlemeyi başlat veya aşağıya bir cümle yaz…</div>
    <div class="tr" id="tr"></div>
  </div>
</main>
<div id="err"></div>
<div class="replies" id="replies"></div>
<form id="form">
  <select id="src">
    <option value="mic">Mikrofon</option>
    <option value="tab">Sekme sesi</option>
  </select>
  <button type="button" class="mic" id="mic">🎙 Dinle</button>
  <input id="inp" autocomplete="off" placeholder="İstersen elle de yazabilirsin, Enter'a bas">
  <button class="send">Gönder</button>
</form>

<script>
const $ = id => document.getElementById(id);
let ws, cur = 0, interimMode = false;

function pushPast() {
  const tr = $("tr").textContent;
  if (!tr || tr === "…" || interimMode) return;
  const p = document.createElement("div");
  p.className = "past";
  p.innerHTML = "<div></div><div class='t'></div>";
  p.children[0].textContent = $("en").textContent;
  p.children[1].textContent = tr;
  $("past").appendChild(p);
  $("main").scrollTop = $("main").scrollHeight;
}

function connect() {
  ws = new WebSocket((location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws");
  ws.onopen = () => $("dot").classList.add("on");
  ws.onclose = () => { $("dot").classList.remove("on"); stopMic(false); setTimeout(connect, 1500); };
  ws.onmessage = e => {
    const m = JSON.parse(e.data);
    if (m.type === "interim") {
      if (!interimMode) { pushPast(); interimMode = true; $("tr").textContent = ""; }
      $("en").textContent = m.text;
      $("en").classList.add("interim");
    } else if (m.type === "en") {
      pushPast();
      interimMode = false;
      cur = m.id;
      $("en").classList.remove("interim");
      $("en").textContent = m.text;
      $("tr").textContent = "…";
      $("err").textContent = "";
      $("replies").innerHTML = "<div class='chip ghost'>Öneriler hazırlanıyor…</div>".repeat(3);
    } else if (m.type === "tr" && m.id === cur) {
      $("tr").textContent = m.text;
    } else if (m.type === "replies" && m.id === cur) {
      $("replies").innerHTML = "";
      m.replies.forEach(r => {
        const b = document.createElement("button");
        b.className = "chip";
        b.textContent = r;
        b.onclick = () => { navigator.clipboard.writeText(r); b.classList.add("copied"); };
        $("replies").appendChild(b);
      });
    } else if (m.type === "error") {
      $("err").textContent = m.text;
    }
  };
}
connect();

/* ---- Ses yakalama: 16 kHz PCM, 100 ms'lik parçalar ---- */
const workletCode = `
class PCM extends AudioWorkletProcessor {
  constructor() { super(); this.ratio = sampleRate / 16000; this.phase = 0; this.acc = 0; this.cnt = 0;
                  this.out = new Int16Array(1600); this.n = 0; }
  process(inputs) {
    const ch = inputs[0][0];
    if (!ch) return true;
    for (let i = 0; i < ch.length; i++) {
      this.acc += ch[i]; this.cnt++; this.phase += 1;
      if (this.phase >= this.ratio) {
        this.phase -= this.ratio;
        const v = Math.max(-1, Math.min(1, this.acc / this.cnt));
        this.out[this.n++] = v < 0 ? v * 32768 : v * 32767;
        this.acc = 0; this.cnt = 0;
        if (this.n === 1600) { this.port.postMessage(this.out.buffer.slice(0)); this.n = 0; }
      }
    }
    return true;
  }
}
registerProcessor("pcm", PCM);`;

let actx = null, stream = null, listening = false;

async function startMic() {
  try {
    stream = $("src").value === "tab"
      ? await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true })
      : await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, channelCount: 1 } });
    stream.getVideoTracks().forEach(t => t.stop());
    if (!stream.getAudioTracks().length) throw new Error("Ses paylaşılmadı. Sekme seçerken 'Sekme sesini de paylaş' kutusunu işaretle.");
    actx = new AudioContext();
    await actx.audioWorklet.addModule(URL.createObjectURL(new Blob([workletCode], { type: "application/javascript" })));
    const src = actx.createMediaStreamSource(new MediaStream(stream.getAudioTracks()));
    const node = new AudioWorkletNode(actx, "pcm");
    const mute = actx.createGain(); mute.gain.value = 0;
    node.port.onmessage = e => { if (ws.readyState === 1) ws.send(e.data); };
    src.connect(node); node.connect(mute); mute.connect(actx.destination);
    ws.send(JSON.stringify({ type: "start" }));
    listening = true;
    $("mic").classList.add("live");
    $("mic").textContent = "■ Durdur";
    $("err").textContent = "";
  } catch (e) {
    $("err").textContent = "Ses hatası: " + e.message;
    stopMic(false);
  }
}

function stopMic(notify = true) {
  if (stream) stream.getTracks().forEach(t => t.stop());
  if (actx) actx.close();
  stream = null; actx = null;
  if (notify && ws.readyState === 1) ws.send(JSON.stringify({ type: "stop" }));
  listening = false;
  $("mic").classList.remove("live");
  $("mic").textContent = "🎙 Dinle";
}

$("mic").onclick = () => listening ? stopMic() : startMic();

$("form").onsubmit = e => {
  e.preventDefault();
  const t = $("inp").value.trim();
  if (!t || ws.readyState !== 1) return;
  ws.send(JSON.stringify({ type: "text", text: t }));
  $("inp").value = "";
};
$("ctx").onchange = () => ws.send(JSON.stringify({ type: "context", text: $("ctx").value }));
</script>
</body>
</html>
